#!/bin/sh
# Quick checks before every commit: formatting, and no forbidden product name in any text file.
# Turn the hooks on once per clone:  git config core.hooksPath .githooks
# These read the working tree, not only what is staged.
set -e
echo "pre-commit: cargo fmt --check"
cargo fmt --all -- --check
echo "pre-commit: cargo xtask names"
cargo xtask names
